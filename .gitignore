# Python virtual environment
.venv/

# Python cache / compiled files
__pycache__/
*.py[cod]

# Environment variables / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Type/lint caches
.mypy_cache/
.ruff_cache/

# VS Code local settings
.vscode/

# OS files
.DS_Store
Thumbs.db
*.egg-info/

# Large reproducible synthetic datasets
generated-data/
review-work/
.benchmark/

# Terraform local state and provider cache
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
